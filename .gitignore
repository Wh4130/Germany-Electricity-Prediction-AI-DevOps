# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# LaTeX build files (report/main.tex is the source)
report/*.aux
report/*.log
report/*.out
report/*.fls
report/*.fdb_latexmk
report/*.xdv
report/*.synctex.gz
report/*.pdf

# Virtual environments
.venv
.env

# per-city weather lookup tables (large, rebuild with src/scripts/weather_etl.py)
src/data/intermin/weather_daily_by_city.csv
src/data/intermin/weather_hourly_by_city.csv

# documentation
src/documentation/
*.md
!docs/**/*.md
docs/meeting/ideas.md
*.json
!src/results/sarimax/**/*.json

# bif raw data
src/data/external_raw/

# Jupyter
.ipynb_checkpoints/

# deployment: copied by deploy/sarimax_api/stage.sh
deploy/sarimax_api/artifacts/
!deploy/dashboard/*.json
!deploy/dashboard/public/*.json
deploy/dashboard/node_modules/
deploy/dashboard/dist/
# terraform: state and local settings (the lock file .terraform.lock.hcl is committed)
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/terraform.tfvars
deploy/terraform/*.tfplan

# user_defined
src/results/foundation/extra_features
src/results/foundation/forecasts
src/results/foundation/metrics
src/results/foundation/report/*.csv
!src/results/foundation/report/*.md
